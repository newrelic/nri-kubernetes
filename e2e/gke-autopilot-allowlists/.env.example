# Copy to `.env` (gitignored) or just let run-gke-autopilot-e2e.sh prompt and offer to save it.
# The runner resolves each value from: environment -> this .env -> interactive prompt.

# Existing GKE Autopilot cluster context. The runner never switches context; it only verifies this.
KUBE_CONTEXT=gke_k8s-o11y-team_us-west2_gke-autopilot-truong

# New Relic backend: US | EU | Staging | Local. Must match the account + keys below. GKE Autopilot
# testing uses a PRODUCTION account (Autopilot is not available on staging), so this is normally US.
# When Staging, the agent is deployed with global.nrStaging=true.
REGION=US

# Which images the workload runs:
#   released -> the published newrelic/nri-kubernetes image (chart default). Zero setup, no registry.
#   local    -> build from local source and push to REGISTRY (below), then run that dev image.
IMAGE_SOURCE=released

# local mode only. Registry host/project the cluster can pull from. The dev image is pushed as
# $REGISTRY/newrelic/nri-kubernetes:$TAG so the CR image regex ^(.*/)?newrelic/nri-kubernetes$ matches.
# Ignored when IMAGE_SOURCE=released.
REGISTRY=us-west2-docker.pkg.dev/k8s-o11y-team
TAG=e2e-gke-ap

# New Relic account. ALL THREE must belong to the SAME account + REGION above: ACCOUNT_ID + USER API
# key drive the NRDB assertions; INGEST license key is what the deployed agent reports with. A common
# failure is a staging API key with a production ACCOUNT_ID (or vice versa) -> 401 / "Access denied".
ACCOUNT_ID=
API_KEY=
LICENSE_KEY=
